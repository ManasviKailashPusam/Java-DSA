Public static void rotateArray(int[]a,int k)
{
    int k=k%a.length;
     if(k<0)  
    {
     k=k+a.length;
    }
   //rotating part 1
   reverse(a,0,a.length-k-1);
   //rotating part2
   reverse(a,a.length-k,a.length-1);
   //rotating whole array
   reverse(a,0,a.length-1);
 }
public static void reverseArray(int[]a,int i,intj)
{
      int li=i;
      int ri=j;
   while(li<ri)
   {
   int temp=a[li];
   a[li]=a[ri];
   a[ri]=temp; 
   }
   li++;
   ri--;
}
