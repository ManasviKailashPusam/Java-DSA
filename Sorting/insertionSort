import java.util.Scanner;
public class Main
{
    public static int insertionSort(int []a,int n)
    {
        for(int i=0;i<n;i++)
        {
            int j=i;
            while(j>0   &&  a[j+1]>a[j])
            {
                int temp=a[j+1];
                a[j+1]=a[j];
                a[j]=temp;
                j--;
            }
        }
    }
}
